{
  "workspace": [
    "./app",
    "./desktop"
  ],
  "nodeModulesDir": "auto",
  "lock": {
    "frozen": true
  },
  "minimumDependencyAge": "P7D",
  "desktop": {
    "app": {
      "name": "Local Medical Charts",
      "icons": { "macos": "./desktop/icon.png" }
    }
  },
  "tasks": {
    "dev": "cd app && deno run -A node_modules/vite/bin/vite.js",
    "build": "cd app && deno run -A node_modules/vite/bin/vite.js build",
    "desktop": "deno task build && MEDICAL_CHARTS_DATA_DIR=.data deno desktop --hmr -A desktop/main.ts",
    "extract": "deno run --allow-read --allow-write src/pdf-to-images.ts",
    "ocr": "deno run --allow-read --allow-write --allow-net src/ocr-reports.ts",
    "test": "deno test --allow-read --allow-write --allow-env=NODE_ENV --allow-net=127.0.0.1 src/ desktop/",
    "map": "deno run --allow-read --allow-write --allow-net src/map-analytes.ts",
    "upgrade": "deno run --allow-read --allow-write src/upgrade-reports.ts",
    "samples": "deno run --allow-read --allow-write scripts/generate-samples.ts",
    "classes": "cd app && deno run --allow-read --allow-write=src tailwind-classes.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/cli": "jsr:@std/cli@1.0.32",
    "@std/encoding": "jsr:@std/encoding@1.0.11",
    "@std/fs": "jsr:@std/fs@1.0.24",
    "@std/http": "jsr:@std/http@1.1.3",
    "@std/path": "jsr:@std/path@1.1.6",
    "@zod/zod": "jsr:@zod/zod@4.6.2",
    "mupdf": "npm:mupdf@1.28.1"
  },
  "fmt": {
    "exclude": [
      "design",
      "src/analytes.json",
      "src/ocr-prompt.md",
      "src/map-prompt.md",
      "app/dist",
      "node_modules",
      "app/node_modules",
      "samples/*.json"
    ]
  },
  "lint": {
    "exclude": [
      "app/dist",
      "node_modules",
      "app/node_modules"
    ]
  }
}
