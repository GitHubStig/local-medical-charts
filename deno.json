{
  "tasks": {
    "dev": "deno run --watch --allow-net main.ts",
    "extract": "deno run --allow-read --allow-write src/pdf-to-images.ts",
    "ocr": "deno run --allow-read --allow-write --allow-net src/ocr-reports.ts",
    "test": "deno test --allow-read src/",
    "map": "deno run --allow-read --allow-write --allow-net src/map-analytes.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/cli": "jsr:@std/cli@^1.0.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.0",
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "mupdf": "npm:mupdf@^1.28.1",
    "@zod/zod": "jsr:@zod/zod@^4.6.2"
  },
  "fmt": {
    "exclude": [
      "src/analytes.json",
      "src/ocr-prompt.md",
      "src/map-prompt.md"
    ]
  }
}
